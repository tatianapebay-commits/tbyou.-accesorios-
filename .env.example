# Copiar este archivo como .env y completar con los datos de tu PostgreSQL
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contraseña
DB_NAME=tbyou_accesorios

# ---- Carrito y pedidos ----
# WhatsApp de la tienda, formato internacional sin + ni espacios (Argentina: 549 + característica + número)
WHATSAPP_NUMERO=5492494000000
# Correo donde llegan los pedidos
EMAIL_PEDIDOS=tbyouaccesorios@gmail.com
# Alias o CBU que se muestra al elegir transferencia
ALIAS_TRANSFERENCIA=tbyou.accesorios
# Link de pago de Mercado Pago (opcional)
LINK_MERCADOPAGO=

# ---- Envío de mails (Gmail) ----
# SMTP_PASS es una "contraseña de aplicación" de Google, no la contraseña común del mail.
# Si se dejan vacíos, la compra funciona igual pero el mail no se envía.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Panel de administración: clave para firmar la cookie de sesión (escribí cualquier frase larga)
SESSION_SECRET=una-frase-larga-y-secreta
